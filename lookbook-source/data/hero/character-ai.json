{"hero":"<div style=\"font-family:'atHauss','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;display:grid;grid-template-rows:auto auto 1fr;font-size:11px;letter-spacing:-0.012em;overflow:hidden;\">\n  <div style=\"padding:10px 12px 8px;display:flex;align-items:center;gap:8px;\">\n    <div style=\"width:25px;height:25px;background:var(--card-accent);color:var(--card-bg);border-radius:8px;display:grid;place-items:center;font:800 9px/1 sans-serif;letter-spacing:-0.06em;\">c.ai</div>\n    <strong style=\"font-size:13px;letter-spacing:-0.025em;\">character.ai</strong>\n    <span style=\"margin-left:auto;color:var(--card-fg-muted);font-size:14px;\">⌕</span>\n  </div>\n  <div style=\"padding:4px 12px 10px;\">\n    <div style=\"background:var(--card-surface);border:1px solid var(--card-border);border-radius:9999px;padding:7px 11px;color:var(--card-fg-muted);display:flex;align-items:center;gap:6px;\"><span>⌕</span><span>Search Characters</span></div>\n    <div style=\"font-size:17px;font-weight:700;line-height:1.12;letter-spacing:-0.035em;margin:13px 1px 5px;\">What do you want<br/>to do?</div>\n    <div style=\"color:var(--card-fg-muted);font-size:10px;\">Start a story with anyone.</div>\n  </div>\n  <div style=\"padding:0 12px 12px;overflow:hidden;\">\n    <div style=\"display:flex;align-items:center;margin-bottom:7px;\"><strong style=\"font-size:12px;\">For you</strong><span style=\"margin-left:auto;color:var(--card-fg-muted);\">See all</span></div>\n    <div style=\"display:flex;flex-direction:column;gap:6px;\">\n      <div style=\"background:var(--card-surface);border:1px solid var(--card-border);border-radius:14px;padding:7px;display:flex;align-items:center;gap:8px;\">\n        <div style=\"width:34px;height:34px;border-radius:50%;background:radial-gradient(circle at 50% 35%,#FDE68A 0 18%,transparent 19%),linear-gradient(145deg,#7C3AED,#C4B5FD);display:grid;place-items:center;color:#fff;font-weight:800;\">S</div>\n        <div style=\"min-width:0;flex:1;\"><div style=\"font-weight:700;\">Story Maker</div><div style=\"color:var(--card-fg-muted);font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">Build a world together</div></div>\n        <span style=\"color:#9B6CFF;\">●</span>\n      </div>\n      <div style=\"background:var(--card-surface);border:1px solid var(--card-border);border-radius:14px;padding:7px;display:flex;align-items:center;gap:8px;\">\n        <div style=\"width:34px;height:34px;border-radius:50%;background:linear-gradient(145deg,#0F766E,#5EEAD4);display:grid;place-items:center;color:#fff;font-weight:800;\">L</div>\n        <div style=\"min-width:0;flex:1;\"><div style=\"font-weight:700;\">Language Coach</div><div style=\"color:var(--card-fg-muted);font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">Practice through conversation</div></div>\n        <span style=\"color:var(--card-fg-muted);\">›</span>\n      </div>\n    </div>\n  </div>\n</div>","card_tokens":{"light":{"bg":"#F4F4F5","surface":"#FFFFFF","border":"#D4D4DA","fg":"#26272B","fg_muted":"#6B7280","accent":"#202024"},"dark":{"bg":"#18181B","surface":"#26272B","border":"#3F3F46","fg":"#FAFAFA","fg_muted":"#A1A1AA","accent":"#F4F4F5"}}}