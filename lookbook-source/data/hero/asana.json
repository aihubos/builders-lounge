id;grid-template-columns:14px minmax(0,1fr) 17px;gap:7px;align-items:center;border-bottom:1px solid var(--card-border);\">\n          <span style=\"width:14px;height:14px;border:1.7px solid #14AAF5;border-radius:50%;\"></span>\n          <div style=\"min-width:0;\"><div style=\"font-size:10px;font-weight:550;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">런칭 체크리스트 검토</div><div style=\"font-size:8px;color:var(--card-fg-muted);margin-top:2px;\"><span style=\"color:#9C5700;background:#FFE2A8;border-radius:3px;padding:1px 4px;\">In progress</span> · 오늘</div></div>\n          <span style=\"width:17px;height:17px;border-radius:50%;background:linear-gradient(135deg,#F06A6A,#FBC850);\"></span>\n        </div>\n        <div style=\"padding:8px;display:grid;grid-template-columns:14px minmax(0,1fr) 17px;gap:7px;align-items:center;border-bottom:1px solid var(--card-border);\">\n          <span style=\"width:14px;height:14px;border:1.7px solid #C7C8CB;border-radius:50%;\"></span>\n          <div style=\"min-width:0;\"><div style=\"font-size:10px;font-weight:550;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">홈 화면 카피 확정</div><div style=\"font-size:8px;color:var(--card-fg-muted);margin-top:2px;\"><span style=\"color:#4A6491;background:#DDF0FA;border-radius:3px;padding:1px 4px;\">Design</span> · 오후 2시</div></div>\n          <span style=\"width:17px;height:17px;border-radius:50%;background:linear-gradient(135deg,#796EFF,#B36BD4);\"></span>\n        </div>\n        <div style=\"padding:8px;display:grid;grid-template-columns:14px minmax(0,1fr);gap:7px;align-items:center;\">\n          <span style=\"width:14px;height:14px;border-radius:50%;background:#36B37E;color:white;display:grid;place-items:center;font-size:9px;\">✓</span>\n          <span style=\"font-size:10px;color:var(--card-fg-muted);text-decoration:line-through;\">주간 목표 공유</span>\n        </div>\n      </div>\n      <div style=\"margin-top:auto;padding-top:8px;color:#796EFF;font-size:9px;font-weight:650;\">＋ 작업 추가</div>\n    </section>\n  </main>\n</div>","card_tokens":{"light":{"bg":"#F6F7F8","surface":"#FFFFFF","border":"#EDEDED","fg":"#1E1F21","fg_muted":"#6F7782","accent":"#F06A6A"},"dark":{"bg":"#1E1F21","surface":"#2A2B2D","border":"#38393B","fg":"#FFFFFF","fg_muted":"#A0A2A6","accent":"#F06A6A"}}}