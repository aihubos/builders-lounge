{"hero":"<div style=\"font-family:Inter,'Pretendard',-apple-system,sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;display:grid;grid-template-columns:42px minmax(0,1fr);overflow:hidden;\">\n  <aside style=\"background:var(--card-surface);border-right:1px solid var(--card-border);padding:10px 7px;display:flex;flex-direction:column;align-items:center;gap:13px;\">\n    <svg width=\"27\" height=\"22\" viewBox=\"0 0 27 22\" aria-label=\"Asana\" style=\"display:block;flex:0 0 auto\"><defs><linearGradient id=\"asana-card-logo\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop stop-color=\"#FF8D70\"/><stop offset=\"1\" stop-color=\"#F06A8A\"/></linearGradient></defs><circle cx=\"13.5\" cy=\"5\" r=\"5\" fill=\"url(#asana-card-logo)\"/><circle cx=\"6\" cy=\"16.5\" r=\"5\" fill=\"url(#asana-card-logo)\"/><circle cx=\"21\" cy=\"16.5\" r=\"5\" fill=\"url(#asana-card-logo)\"/></svg>\n    <span style=\"width:27px;height:27px;border-radius:7px;background:#FDECEC;color:#BD4747;display:grid;place-items:center;\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 4H5a2 2 0 0 0-2 2v4h6V4Z\"/><path d=\"M21 10V6a2 2 0 0 0-2-2h-4v6h6Z\"/><path d=\"M9 20H5a2 2 0 0 1-2-2v-4h6v6Z\"/><path d=\"M21 14v4a2 2 0 0 1-2 2h-4v-6h6Z\"/></svg></span>\n    <span style=\"color:var(--card-fg-muted);display:grid;place-items:center;\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"m8.5 12 2.2 2.2 4.8-5\"/></svg></span>\n    <span style=\"color:var(--card-fg-muted);display:grid;place-items:center;\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M5 4h14v16H5z\"/><path d=\"M8 8h8M8 12h8M8 16h5\"/></svg></span>\n    <span style=\"color:var(--card-fg-muted);display:grid;place-items:center;\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 2