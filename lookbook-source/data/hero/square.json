{"hero":"<div style=\"font-family:'Square Sans',Inter,'Pretendard',-apple-system,sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;min-height:300px;display:flex;flex-direction:column;overflow:hidden;\">\n  <div style=\"height:43px;border-bottom:1px solid var(--card-border);padding:0 13px;display:flex;align-items:center;gap:8px;flex:none;\">\n    <span style=\"width:20px;height:20px;background:var(--card-accent);border-radius:5px;display:grid;place-items:center;flex:none;\"><span style=\"width:8px;height:8px;border:2px solid var(--card-bg);border-radius:2px;\"></span></span>\n    <strong style=\"font-size:12px;font-weight:700;letter-spacing:-.01em;\">Square</strong>\n    <span style=\"margin-left:auto;width:25px;height:25px;border:1px solid var(--card-border);border-radius:50%;display:grid;place-items:center;font-size:10px;font-weight:700;\">MC</span>\n  </div>\n  <div style=\"padding:12px 13px 13px;display:flex;flex-direction:column;gap:9px;min-height:0;flex:1;\">\n    <div style=\"display:flex;align-items:center;justify-content:space-between;\">\n      <span style=\"font-size:9px;color:var(--card-fg-muted);font-weight:700;letter-spacing:.08em;text-transform:uppercase;\">New sale</span>\n      <span style=\"font-size:9px;color:var(--card-fg-muted);\">1 item</span>\n    </div>\n    <div style=\"border:1px solid var(--card-border);border-radius:10px;padding:10px;background:var(--card-surface);\">\n      <div style=\"display:flex;justify-content:space-between;gap:8px;font-size:11px;\"><span>Oat latte</span><strong>$6.50</strong></div>\n      <div style=\"height:1px;background:var(--card-border);margin:8px 0;\"></div>\n      <div style=\"display:flex;justify-content:space-between;align-items:baseline;\"><strong style=\"font-size:11px;\">Total</strong><strong style=\"font-size:25px;letter-spacing:-.04em;\">$6.50</strong></div>\n    </div>\n    <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:5px;\">\n      <span style=\"height:29px;border:1px solid var(--card-border);border-radius:7px;display:grid;place-items:center;font-size:10px;font-weight:700;\">1</span>\n      <span style=\"height:29px;border:1px solid var(--card-border);border-radius:7px;display:grid;place-items:center;font-size:10px;font-weight:700;\">2</span>\n      <span style=\"height:29px;border:1px solid var(--card-border);border-radius:7px;display:grid;place-items:center;font-size:10px;font-weight:700;\">3</span>\n    </div>\n    <div style=\"margin-top:auto;background:var(--card-accent);color:var(--card-bg);border-radius:8px;padding:10px 11px;display:flex;align-items:center;justify-content:space-between;\">\n      <span style=\"font-size:11px;font-weight:700;\">Charge $6.50</span>\n      <span style=\"display:flex;align-items:center;gap:4px;font-size:8px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 4.8a4.5 4.5 0 0 1 0 6.4M8 2.3a8 8 0 0 1 0 11.4M2.3 7.1a1.3 1.3 0 0 1 0 1.8\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>Tap</span>\n    </div>\n  </div>\n</div>","card_tokens":{"light":{"bg":"#FFFFFF","surface":"#F5F5F5","border":"#E5E5E5","fg":"#000000","fg_muted":"#666666","accent":"#000000"},"dark":{"bg":"#000000","surface":"#1A1A1A","border":"#2D2D2D","fg":"#FFFFFF","fg_muted":"#999999","accent":"#FFFFFF"}}}