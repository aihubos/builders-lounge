{"hero":"<div class=\"ln-card\">\n  <style>\n    .ln-card{font-family:Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:linear-gradient(155deg,#F8FCFF 0%,#E4F1FF 42%,#A9D2FA 100%);color:#0E2E5C;height:100%;min-height:260px;display:grid;grid-template-rows:auto 1fr auto;position:relative;overflow:hidden;isolation:isolate}\n    .ln-card *{box-sizing:border-box}.ln-card::before{content:\"\";position:absolute;width:250px;height:110px;right:-86px;top:62px;border:1px solid rgba(255,255,255,.72);border-radius:50%;transform:rotate(-28deg);box-shadow:0 0 0 18px rgba(255,255,255,.13),0 0 0 42px rgba(255,255,255,.09)}\n    .ln-head{padding:15px 16px 4px;display:flex;align-items:center;justify-content:space-between;position:relative;z-index:2}.ln-wordmark{font-size:17px;font-weight:500;letter-spacing:.24em;color:#185FB9}.ln-dots{display:flex;gap:3px}.ln-dots i{width:3px;height:3px;border-radius:50%;background:#185FB9;display:block}\n    .ln-stage{position:relative;min-height:0}.ln-copy{position:absolute;left:16px;top:18px;width:56%;z-index:2}.ln-kicker{font-size:7px;font-weight:700;letter-spacing:.17em;color:#3976B9;margin-bottom:8px}.ln-copy h2{font-size:21px;font-weight:350;line-height:1.02;letter-spacing:-.035em;margin:0;color:#0E2E5C}.ln-copy h2 strong{display:block;font-weight:750}.ln-copy p{font-size:8px;line-height:1.45;color:#4E6E93;margin:8px 0 0;max-width:96px}\n    .ln-product{position:absolute;right:4px;bottom:1px;width:102px;height:148px;z-index:1}.ln-product::after{content:\"\";position:absolute;width:88px;height:16px;left:3px;bottom:2px;border-radius:50%;background:rgba(21,86,164,.20);filter:blur(7px)}\n    .ln-lid{position:absolute;left:22px;top:18px;width:67px;height:35px;border-radius:17px 17px 12px 12px;background:linear-gradient(145deg,#FFFFFF 0%,#D9EAF7 48%,#9BBAD2 100%);border:1px solid rgba(255,255,255,.95);box-shadow:inset 8px 5px 10px rgba(255,255,255,.72),0 4px 10px rgba(24,89,167,.18);z-index:2}.ln-lid::after{content:\"\";position:absolute;left:8px;right:8px;top:5px;height:7px;border-radius:50%;background:rgba(255,255,255,.8)}\n    .ln-jar{position:absolute;left:14px;top:43px;width:82px;height:87px;border-radius:15px 15px 24px 24px;background:linear-gradient(142deg,rgba(245,252,255,.96) 0%,rgba(151,205,247,.88) 46%,rgba(58,134,211,.84) 100%);border:1px solid rgba(255,255,255,.9);box-shadow:inset 10px 8px 15px rgba(255,255,255,.48),inset -8px -8px 16px rgba(38,110,189,.16),0 16px 22px rgba(22,91,170,.28);overflow:hidden}.ln-jar::before{content:\"\";position:absolute;left:11px;top:10px;width:13px;height:52px;border-radius:50%;background:linear-gradient(180deg,rgba(255,255,255,.86),rgba(255,255,255,.05));transform:rotate(8deg)}.ln-label{position:absolute;left:0;right:0;top:36px;text-align:center;color:#14549C}.ln-label b{display:block;font-size:8px;line-height:1.1;letter-spacing:.13em}.ln-label small{display:block;font-size:4px;font-weight:700;letter-spacing:.08em;margin-top:3px}\n    .ln-drop{position:absolute;border-radius:50% 50% 55% 45%;background:radial-gradient(circle at 32% 27%,#FFFFFF 0 11%,rgba(255,255,255,.55) 12%,rgba(90,163,226,.18) 58%,rgba(34,113,194,.32) 100%);border:1px solid rgba(255,255,255,.76);box-shadow:inset 2px 2px 5px rgba(255,255,255,.7),0 4px 9px rgba(30,99,196,.12)}.ln-drop.a{width:18px;height:18px;right:10px;top:15px}.ln-drop.b{width:10px;height:10px;right:91px;top:63px}.ln-drop.c{width:7px;height:7px;right:3px;top:76px}\n    .ln-foot{margin:0 12px 12px;padding:8px 9px 8px 11px;border:1px solid rgba(255,255,255,.68);border-radius:11px;background:rgba(255,255,255,.48);box-shadow:inset 0 1px 0 rgba(255,255,255,.7);backdrop-filter:blur(7px);display:flex;align-items:center;justify-content:space-between;position:relative;z-index:2}.ln-foot span{font-size:7px;font-weight:700;letter-spacing:.12em;color:#1751A6}.ln-foot b{font-size:9px;letter-spacing:-.01em}.ln-arrow{width:20px;height:20px;border-radius:50%;background:#1E63C4;color:#fff;display:grid;place-items:center;font-size:12px}\n  </style>\n  <header class=\"ln-head\"><span class=\"ln-wordmark\">LANEIGE</span><span class=\"ln-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span></header>\n  <div class=\"ln-stage\">\n    <div class=\"ln-copy\"><div class=\"ln-kicker\">OPEN TO WONDER</div><h2>Deeply<br/><strong>Hydrated.</strong></h2><p>블루 히알루론산으로 채우는 피부 장벽 수분 케어</p></div>\n    <div class=\"ln-product\" aria-label=\"워터뱅크 블루 히알루로닉 크림\">\n      <span class=\"ln-drop a\"></span><span class=\"ln-drop b\"></span><span class=\"ln-drop c\"></span>\n      <div class=\"ln-lid\"></div>\n      <div class=\"ln-jar\"><div class=\"ln-label\"><b>WATER BANK</b><small>BLUE HYALURONIC</small></div></div>\n    </div>\n  </div>\n  <div class=\"ln-foot\"><div><span>WATER BANK</span><br/><b>나에게 맞춘 장벽 수분</b></div><div class=\"ln-arrow\" aria-hidden=\"true\">→</div></div>\n</div>","card_tokens":null}