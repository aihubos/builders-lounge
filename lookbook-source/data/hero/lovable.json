{"hero":"<div style=\"font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;display:grid;grid-template-rows:34px 1fr;font-size:9px;letter-spacing:-0.01em;\">\n  <div style=\"background:var(--card-surface);border-bottom:1px solid var(--card-border);display:flex;align-items:center;gap:7px;padding:0 9px;\">\n    <div style=\"width:18px;height:18px;background:linear-gradient(135deg,#FF4F86,#FF8A4F);border-radius:6px;display:grid;place-items:center;color:#fff;font-size:10px;box-shadow:0 3px 8px rgba(255,79,134,.22);\">♥</div>\n    <span style=\"font-weight:650;white-space:nowrap;\">Sunnyside</span>\n    <span style=\"margin-left:auto;color:var(--card-fg-muted);\">Preview</span>\n    <span style=\"background:linear-gradient(135deg,#FF4F86,#FF8A4F);color:#fff;border-radius:6px;padding:4px 7px;font-weight:650;\">Share</span>\n  </div>\n  <div style=\"min-height:0;display:grid;grid-template-columns:43% 57%;padding:7px;gap:6px;\">\n    <div style=\"min-width:0;background:var(--card-surface);border:1px solid var(--card-border);border-radius:10px;display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;\">\n      <div style=\"padding:8px 8px 6px;display:flex;align-items:center;gap:5px;border-bottom:1px solid var(--card-border);\"><span style=\"width:14px;height:14px;background:linear-gradient(135deg,#FF4F86,#FF8A4F);border-radius:5px;display:grid;place-items:center;color:#fff;font-size:7px;\">♥</span><strong>Agent</strong><span style=\"margin-left:auto;color:var(--card-fg-muted);\">•••</span></div>\n      <div style=\"padding:8px;display:flex;flex-direction:column;gap:7px;overflow:hidden;\">\n        <div style=\"align-self:flex-end;background:var(--card-bg);border:1px solid var(--card-border);border-radius:9px 9px 3px 9px;padding:6px 7px;line-height:1.35;\">따뜻한 여행 플래너를 만들어줘</div>\n        <div style=\"display:flex;gap:5px;line-height:1.35;\"><span style=\"color:var(--card-accent);\">♥</span><s