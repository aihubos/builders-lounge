t:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">오늘의 첫 번째 트랙</div><div style=\"font-size:8px;color:var(--card-fg-muted);font-weight:600;margin-top:2px;\">Melon Pick</div></div>\n      <svg viewBox=\"0 0 24 24\" width=\"21\" height=\"21\" style=\"color:var(--card-accent);\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"currentColor\"/><path d=\"m10 8 6 4-6 4z\" fill=\"#fff\"/></svg>\n    </div>\n  </div>\n  <div style=\"height:45px;padding:6px 11px;background:var(--card-surface);border-top:1px solid var(--card-border);display:grid;grid-template-columns:33px 1fr auto;gap:8px;align-items:center;flex:0 0 auto;\">\n    <div style=\"width:33px;height:33px;border-radius:4px;background:linear-gradient(135deg,#F7D36D,#E2675A 50%,#56375F);\"></div>\n    <div style=\"min-width:0;\"><div style=\"font-size:9px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">음악이 필요한 순간</div><div style=\"font-size:8px;color:var(--card-fg-muted);font-weight:600;margin-top:2px;\">Melon</div></div>\n    <div style=\"display:flex;align-items:center;gap:7px;color:var(--card-fg);\">\n      <svg viewBox=\"0 0 24 24\" width=\"17\" height=\"17\" aria-hidden=\"true\"><path d=\"M8 5v14M16 5v14\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg>\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"m9 7 8 5-8 5z\" fill=\"currentColor\"/></svg>\n    </div>\n  </div>\n</div>","card_tokens":{"light":{"bg":"#FFFFFF","surface":"#F8F9FA","border":"#ECEEF0","fg":"#1B1B1B","fg_muted":"#5F6368","accent":"#00CD3C"},"dark":{"bg":"#121212","surface":"#232427","border":"#2D2F33","fg":"#F8F9FA","fg_muted":"#BCC0C4","accent":"#14D050"}}}