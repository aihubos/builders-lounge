{"hero":"<div style=\"font-family:Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;min-height:300px;display:flex;flex-direction:column;overflow:hidden;letter-spacing:-0.02em;\">\n  <div style=\"height:43px;padding:0 13px;display:flex;align-items:center;border-bottom:1px solid var(--card-border);flex:0 0 auto;\">\n    <div style=\"display:flex;align-items:center;gap:6px;color:var(--card-accent);\">\n      <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"currentColor\"/><path d=\"M6.5 13.7c2.1-3.9 4.1-5.8 5.9-5.8 1.7 0 2.8 1.6 2.8 3.4 0 1.6-.8 3-2.1 3.8 1.8.1 3.2-.5 4.4-1.8\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\"/></svg>\n      <strong style=\"font-size:17px;font-weight:900;letter-spacing:-0.05em;\">Melon</strong>\n    </div>\n    <div style=\"margin-left:auto;display:flex;gap:9px;color:var(--card-fg);\">\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"m16 16 4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"M5 7.5h14M5 12h14M5 16.5h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n    </div>\n  </div>\n  <div style=\"padding:11px 12px 9px;display:flex;flex-direction:column;gap:8px;flex:1;min-height:0;\">\n    <div>\n      <div style=\"font-size:9px;font-weight:700;color:var(--card-fg-muted);\">회원님이 좋아할 음악</div>\n      <div style=\"font-size:16px;font-weight:900;margin-top:1px;\">오늘의 맞춤 MIX</div>\n    </div>\n    <div style=\"height:92px;border-radius:12px;background:linear-gradient(135deg,#073B1A 0%,#006D29 52%,#00CD3C 100%);color:#fff;padding:11px;display:grid;grid-template-c