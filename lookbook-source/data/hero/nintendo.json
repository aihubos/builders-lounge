{"hero":"<div style=\"font-family:'Nintendo Std','Arial Rounded MT Bold','Segoe UI',sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;font-size:11px;letter-spacing:-0.01em;\">\n  <div style=\"padding:9px 12px;display:flex;align-items:center;gap:8px;background:var(--card-accent);color:#fff;\">\n    <span style=\"border:1.5px solid #fff;border-radius:999px;padding:3px 8px;font:800 10px/1 Arial,sans-serif;letter-spacing:-0.04em;\">Nintendo</span>\n    <span style=\"margin-left:auto;display:flex;align-items:center;gap:5px;font:800 9px/1 Arial,sans-serif;letter-spacing:0.04em;\"><span style=\"display:grid;grid-template-columns:repeat(2,7px);gap:2px;height:14px;\"><i style=\"display:block;border:1.5px solid #fff;border-radius:5px 2px 2px 5px;position:relative;\"></i><i style=\"display:block;background:#fff;border-radius:2px 5px 5px 2px;\"></i></span>SWITCH</span>\n  </div>\n  <div style=\"padding:13px 14px 10px;display:flex;flex-direction:column;min-height:0;background:radial-gradient(circle at 94% 8%,rgba(230,0,18,.14),transparent 38%),var(--card-bg);\">\n    <span style=\"color:var(--card-accent);font:800 9px/1 Arial,sans-serif;letter-spacing:.14em;\">PLAY TOGETHER</span>\n    <strong style=\"margin-top:5px;font-size:19px;line-height:1.05;letter-spacing:-.045em;\">어디서나, 함께.</strong>\n    <span style=\"margin-top:5px;color:var(--card-fg-muted);font-size:10px;\">게임의 즐거움을 한 화면에.</span>\n    <div style=\"margin:auto;display:flex;align-items:center;filter:drop-shadow(0 9px 9px rgba(0,0,0,.18));\">\n      <div style=\"width:26px;height:75px;background:#00C3E3;border-radius:16px 4px 4px 16px;position:relative;\"><span style=\"position:absolute;top:13px;left:8px;width:10px;height:10px;border:2px solid #fff;border-radius:50%;\"></span><span style=\"position:absolute;bottom:15px;left:10px;width:6px;height:6px;background:#fff;border-radius:50%;\"></span></div>\n      <div style=\"width:112px;height:6