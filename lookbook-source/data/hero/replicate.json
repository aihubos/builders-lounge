{"hero":"<div style=\"font-family:'Söhne','ABC Favorit',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;display:grid;grid-template-rows:36px 1fr;overflow:hidden;letter-spacing:-0.01em;\">\n  <div style=\"padding:0 11px;display:flex;align-items:center;gap:7px;border-bottom:1px solid var(--card-border);\">\n    <svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" aria-hidden=\"true\" style=\"display:block;flex:none;\"><path d=\"M1 1h16v3H4v13H1V1Zm5 5h11v3H9v8H6V6Zm5 5h6v6h-3v-3h-3v-3Z\" fill=\"var(--card-fg)\"/></svg>\n    <strong style=\"font-size:11px;font-weight:650;\">replicate</strong>\n    <span style=\"margin-left:auto;font-size:8px;color:var(--card-fg-muted);\">Explore</span>\n    <span style=\"font-size:8px;color:var(--card-fg-muted);\">Docs</span>\n    <span style=\"font-size:8px;padding:4px 6px;background:var(--card-accent);color:var(--card-bg);font-weight:650;\">Try free</span>\n  </div>\n  <div style=\"min-height:0;padding:13px 11px 10px;display:flex;flex-direction:column;\">\n    <div style=\"font-size:8px;color:var(--card-fg-muted);margin-bottom:7px;\">● Compare models in the Playground →</div>\n    <div style=\"font-size:26px;line-height:.92;font-weight:650;letter-spacing:-0.055em;\">Run AI<br>with an API.</div>\n    <div style=\"font-size:9px;line-height:1.35;color:var(--card-fg-muted);margin-top:8px;max-width:170px;\">Run and fine-tune models. Deploy custom models. All with one line of code.</div>\n    <div style=\"margin-top:auto;border:1px solid var(--card-border);background:var(--card-surface);\">\n      <div style=\"height:24px;padding:0 8px;display:flex;align-items:center;gap:9px;border-bottom:1px solid var(--card-border);font-size:8px;\">\n        <strong style=\"color:var(--card-fg);\">Python</strong><span style=\"color:var(--card-fg-muted);\">Node</span><span style=\"color:var(--card-fg-muted);\">HTTP</span>\n        <span style=\"margin-left:auto;color:var(--card-fg-muted);\">Copy</span>\n      </div>\n      <div style=\"padding:7px 8px 6px;font:7.5px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:nowrap;\">\n        <div><span style=\"color:var(--card-fg-muted);\">import</span> replicate</div>\n        <div>output = replicate.run(</div>\n        <div style=\"padding-left:9px;color:var(--card-fg-muted);\">\"black-forest-labs/flux-2-pro\",</div>\n        <div style=\"padding-left:9px;\">input={\"prompt\": <span style=\"color:var(--card-fg-muted);\">\"poolside at sunset\"</span>}</div>\n        <div>)</div>\n      </div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:3px;padding:0 6px 6px;\">\n        <span style=\"height:28px;background:linear-gradient(135deg,#EFAE72 0%,#6D8797 55%,#25343C 100%);\"></span>\n        <span style=\"height:28px;background:radial-gradient(circle at 65% 35%,#F5D69A 0 16%,transparent 17%),linear-gradient(145deg,#6E8D75,#302E48);\"></span>\n        <span style=\"height:28px;background:linear-gradient(135deg,#C77054,#E4C88D 48%,#587F8E);\"></span>\n      </div>\n    </div>\n  </div>\n</div>","card_tokens":{"light":{"bg":"#FFFFFF","surface":"#F7F7F5","border":"#DEDEDA","fg":"#151515","fg_muted":"#686865","accent":"#000000"},"dark":{"bg":"#101010","surface":"#1B1B1A","border":"#353533","fg":"#F4F4F1","fg_muted":"#A5A5A0","accent":"#FFFFFF"}}}