{"hero":"<div style=\"font-family:'OpenAI Sans',-apple-system,BlinkMacSystemFont,'Segoe UI','Pretendard',sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;padding:0;display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;\">\n  <div style=\"height:42px;padding:0 12px;display:flex;align-items:center;gap:9px;\">\n    <span style=\"width:25px;height:25px;border-radius:50%;display:grid;place-items:center;color:var(--card-fg);font-size:17px;line-height:1;\">☰</span>\n    <strong style=\"font-size:12px;letter-spacing:-.01em;\">ChatGPT <span style=\"color:var(--card-fg-muted);font-weight:500;\">⌄</span></strong>\n    <span style=\"margin-left:auto;width:26px;height:26px;border:1px solid var(--card-border);border-radius:50%;display:grid;place-items:center;font-size:11px;\">↗</span>\n  </div>\n  <div style=\"padding:23px 12px 10px;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:0;\">\n    <div style=\"width:28px;height:28px;border:1px solid var(--card-border);border-radius:10px;display:grid;place-items:center;margin-bottom:11px;background:var(--card-surface);font-size:15px;\">✦</div>\n    <div style=\"font-size:14px;font-weight:600;letter-spacing:-.025em;margin-bottom:15px;\">오늘은 무엇을 도와드릴까요?</div>\n    <div style=\"width:100%;display:grid;grid-template-columns:1fr 1fr;gap:6px;\">\n      <div style=\"border:1px solid var(--card-border);border-radius:10px;padding:8px 9px;font-size:10px;line-height:1.25;\">아이디어<br><span style=\"color:var(--card-fg-muted);\">함께 발전시키기</span></div>\n      <div style=\"border:1px solid var(--card-border);border-radius:10px;padding:8px 9px;font-size:10px;line-height:1.25;\">코드<br><span style=\"color:var(--card-fg-muted);\">문제 해결하기</span></div>\n    </div>\n  </div>\n  <div style=\"padding:8px 11px 10px;\">\n    <div style=\"background:var(--card-surface);border:1px solid var(--card-border);border-radius:19px;padding:9px 9px 7px 12px;color:var(--card-fg-muted);font-size:10px;\">\n     