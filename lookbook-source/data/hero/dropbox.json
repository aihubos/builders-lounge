{"hero":"<div style=\"font-family:'Sharp Grotesk','Arial Narrow','Pretendard',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;display:grid;grid-template-rows:42px minmax(0,1fr);letter-spacing:-0.01em;\">\n  <div style=\"border-bottom:1px solid var(--card-border);padding:0 11px;display:flex;align-items:center;gap:7px;\">\n    <svg viewBox=\"0 0 32 26\" aria-hidden=\"true\" style=\"width:21px;height:18px;display:block;fill:var(--card-accent);flex:none;\"><polygon points=\"1,5 8,1 15,5 8,9\"/><polygon points=\"17,5 24,1 31,5 24,9\"/><polygon points=\"1,14 8,10 15,14 8,18\"/><polygon points=\"17,14 24,10 31,14 24,18\"/><polygon points=\"8,20 16,15.5 24,20 16,25\"/></svg>\n    <strong style=\"font-size:12px;font-weight:700;\">Dropbox</strong>\n    <div style=\"margin-left:auto;display:flex;align-items:center;gap:7px;\">\n      <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\" style=\"width:14px;height:14px;fill:none;stroke:var(--card-fg-muted);stroke-width:1.5;\"><circle cx=\"8.5\" cy=\"8.5\" r=\"5.5\"/><path d=\"m13 13 4 4\"/></svg>\n      <span style=\"width:20px;height:20px;background:var(--card-accent);color:#fff;display:grid;place-items:center;font:700 8px/1 Arial,sans-serif;\">MK</span>\n    </div>\n  </div>\n  <div style=\"display:grid;grid-template-columns:44px minmax(0,1fr);min-height:0;\">\n    <div style=\"background:var(--card-surface);border-right:1px solid var(--card-border);padding:9px 7px;display:flex;flex-direction:column;align-items:center;gap:6px;\">\n      <span style=\"width:30px;height:30px;background:var(--card-accent);color:#fff;display:grid;place-items:center;\">\n        <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\" style=\"width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.6;\"><path d=\"M3 8.5 10 3l7 5.5V17H3Z\"/><path d=\"M7.5 17v-5h5v5\"/></svg>\n      </span>\n      <span style=\"width:30px;height:30px;color:var(--card-fg-muted);display:grid;place-items:cente