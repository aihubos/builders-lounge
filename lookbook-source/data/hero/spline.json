{"hero":"<div class=\"sp-card\">\n  <style>\n    .sp-card{height:100%;display:grid;grid-template-rows:31px 1fr;font-family:'Spline Sans','Pretendard',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--card-bg,#F4F4F5);color:var(--card-fg,#18181B);overflow:hidden}\n    .sp-card *{box-sizing:border-box}.sp-head{display:flex;align-items:center;gap:6px;padding:0 9px;background:var(--card-surface,#FFFFFF);border-bottom:1px solid var(--card-border,#E4E4E7);font-size:8px}.sp-logo{width:15px;height:15px;display:grid;place-items:center;border-radius:5px;background:#151519;color:#fff;font-size:8px;font-weight:800}.sp-name{font-size:10px;font-weight:700;letter-spacing:-.02em}.sp-file{color:var(--card-fg-muted,#71717A);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sp-play{margin-left:auto;padding:4px 7px;border-radius:5px;background:var(--card-accent,#5E5CE6);color:#fff;font-size:6px;font-weight:750;letter-spacing:.05em}\n    .sp-work{min-height:0;display:grid;grid-template-columns:49px 1fr 57px}.sp-side{position:relative;z-index:2;background:var(--card-surface,#FFFFFF);border-color:var(--card-border,#E4E4E7);font-size:6px;color:var(--card-fg-muted,#71717A);overflow:hidden}.sp-side.left{border-right:1px solid var(--card-border,#E4E4E7);padding:8px 5px}.sp-side.right{border-left:1px solid var(--card-border,#E4E4E7);padding:8px 5px}.sp-label{margin:0 2px 6px;font-weight:750;text-transform:uppercase;letter-spacing:.08em}.sp-layer{display:flex;align-items:center;gap:3px;padding:4px;border-radius:4px;margin-bottom:2px;white-space:nowrap}.sp-layer.sel{background:color-mix(in srgb,var(--card-accent,#5E5CE6) 15%,transparent);color:var(--card-accent,#5E5CE6)}.sp-cube{width:6px;height:6px;border:1px solid currentColor;transform:rotate(30deg)}.sp-prop{padding:5px 0;border-top:1px solid var(--card-border,#E4E4E7)}.sp-prop:first-of-type{border-top:0}.sp-row{display:flex;justify-content:space-between;gap:3px;margin-top:4px}.sp-field{padding:3px;border-radius:3px;background:var(--card-bg,#F4F4F5);color:var(--card-fg,#18181B);font-variant-numeric:tabular-nums}\n    .sp-canvas{position:relative;overflow:hidden;background:radial-gradient(circle at 50% 42%,color-mix(in srgb,var(--card-accent,#5E5CE6) 13%,transparent),transparent 40%),var(--card-bg,#F4F4F5)}.sp-canvas:before{content:\"\";position:absolute;inset:0;background-image:linear-gradient(var(--card-border,#E4E4E7) 1px,transparent 1px),linear-gradient(90deg,var(--card-border,#E4E4E7) 1px,transparent 1px);background-size:15px 15px;opacity:.3;transform:perspective(120px) rotateX(62deg) translateY(42%);transform-origin:bottom}.sp-tools{position:absolute;z-index:3;top:7px;left:50%;transform:translateX(-50%);display:flex;gap:2px;padding:3px;border:1px solid var(--card-border,#E4E4E7);border-radius:6px;background:var(--card-surface,#FFFFFF);box-shadow:0 4px 12px rgba(18,18,24,.1)}.sp-tool{width:12px;height:12px;display:grid;place-items:center;border-radius:3px;font-size:7px}.sp-tool.on{background:var(--card-accent,#5E5CE6);color:#fff}.sp-scene{position:absolute;left:50%;top:51%;width:84px;height:92px;transform:translate(-50%,-48%)}.sp-ring{position:absolute;left:11px;top:16px;width:62px;height:62px;border:17px solid #7667EF;border-top-color:#B9A9FF;border-right-color:#4A3AB7;border-radius:49% 51% 45% 55%;transform:rotate(-25deg) skewY(8deg);box-shadow:0 14px 20px rgba(94,92,230,.28),inset 6px 8px 10px rgba(255,255,255,.24)}.sp-ball{position:absolute;right:3px;top:4px;width:27px;height:27px;border-radius:50%;background:radial-gradient(circle at 31% 27%,#FFF4B8 0,#FFB85C 28%,#F16E62 72%,#A72E75 100%);box-shadow:0 8px 14px rgba(241,110,98,.32)}.sp-pill{position:absolute;left:3px;bottom:0;width:20px;height:37px;border-radius:12px;background:linear-gradient(145deg,#B9F4FF,#48B9FF 46%,#4264D9);transform:rotate(28deg);box-shadow:0 8px 14px rgba(64,165,255,.28)}.sp-select{position:absolute;inset:9px 2px 3px 2px;border:1px solid var(--card-accent,#5E5CE6);pointer-events:none}.sp-select i{position:absolute;width:4px;height:4px;border:1px solid var(--card-accent,#5E5CE6);background:var(--card-surface,#FFFFFF)}.sp-select i:nth-child(1){left:-3px;top:-3px}.sp-select i:nth-child(2){right:-3px;top:-3px}.sp-select i:nth-child(3){right:-3px;bottom:-3px}.sp-select i:nth-child(4){left:-3px;bottom:-3px}.sp-zoom{position:absolute;right:6px;bottom:6px;padding:4px 6px;border:1px solid var(--card-border,#E4E4E7);border-radius:5px;background:var(--card-surface,#FFFFFF);color:var(--card-fg-muted,#71717A);font-size:6px}\n  </style>\n  <div class=\"sp-head\"><span class=\"sp-logo\">S</span><span class=\"sp-name\">Spline</span><span class=\"sp-file\">Dreamy Type.spline</span><span class=\"sp-play\">▶ PLAY</span></div>\n  <div class=\"sp-work\">\n    <aside class=\"sp-side left\"><div class=\"sp-label\">Objects</div><div class=\"sp-layer\"><i class=\"sp-cube\"></i>Camera</div><div class=\"sp-layer\"><i class=\"sp-cube\"></i>Light</div><div class=\"sp-layer sel\"><i class=\"sp-cube\"></i>Shape</div><div class=\"sp-layer\"><i class=\"sp-cube\"></i>Floor</div></aside>\n    <main class=\"sp-canvas\"><div class=\"sp-tools\"><span class=\"sp-tool on\">↖</span><span class=\"sp-tool\">＋</span><span class=\"sp-tool\">◇</span></div><div class=\"sp-scene\"><div class=\"sp-ring\"></div><div class=\"sp-ball\"></div><div class=\"sp-pill\"></div><div class=\"sp-select\"><i></i><i></i><i></i><i></i></div></div><span class=\"sp-zoom\">100%</span></main>\n    <aside class=\"sp-side right\"><div class=\"sp-label\">Design</div><div class=\"sp-prop\">Transform<div class=\"sp-row\"><span>X</span><span class=\"sp-field\">0.0</span></div><div class=\"sp-row\"><span>Y</span><span class=\"sp-field\">0.0</span></div></div><div class=\"sp-prop\">Material<div class=\"sp-row\"><span>Color</span><span style=\"width:10px;height:10px;border-radius:3px;background:linear-gradient(135deg,#B9A9FF,#5E5CE6)\"></span></div></div><div class=\"sp-prop\">Events<div class=\"sp-row\" style=\"color:var(--card-accent,#5E5CE6)\">Hover ↗</div></div></aside>\n  </div>\n</div>","card_tokens":{"light":{"bg":"#F4F4F5","surface":"#FFFFFF","border":"#E4E4E7","fg":"#18181B","fg_muted":"#71717A","accent":"#5E5CE6"},"dark":{"bg":"#0E0E14","surface":"#181820","border":"#2B2B34","fg":"#F7F7FA","fg_muted":"#A0A0B4","accent":"#8580F4"}}}