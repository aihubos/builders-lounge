{"hero":"<div style=\"font-family:Figtree,Inter,'Pretendard',-apple-system,sans-serif;background:var(--card-bg);color:var(--card-fg);height:100%;min-height:0;display:grid;grid-template-rows:38px auto 1fr;overflow:hidden;\">\n  <div style=\"display:flex;align-items:center;gap:9px;padding:0 12px;border-bottom:1px solid var(--card-border);background:var(--card-bg);\">\n    <span style=\"display:flex;align-items:flex-end;gap:2px;width:27px;height:22px;\">\n      <i style=\"display:block;width:5px;height:17px;border-radius:5px;background:#F62B54;transform:rotate(35deg);\"></i>\n      <i style=\"display:block;width:5px;height:14px;border-radius:5px;background:#FFCB00;transform:rotate(35deg);margin-bottom:1px;\"></i>\n      <i style=\"display:block;width:5px;height:11px;border-radius:5px;background:#00C875;transform:rotate(35deg);margin-bottom:2px;\"></i>\n      <i style=\"display:block;width:5px;height:5px;border-radius:50%;background:#579BFC;margin:0 0 2px 2px;\"></i>\n    </span>\n    <strong style=\"font-size:13px;letter-spacing:-.02em;\">monday</strong>\n    <span style=\"margin-left:auto;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#A25DDC;color:#fff;font-size:9px;font-weight:700;\">MK</span>\n  </div>\n  <div style=\"padding:10px 12px 8px;background:var(--card-bg);\">\n    <div style=\"display:flex;align-items:center;gap:7px;\">\n      <span style=\"width:7px;height:20px;border-radius:4px;background:#579BFC;\"></span>\n      <div style=\"min-width:0;\">\n        <div style=\"font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">Product launch</div>\n        <div style=\"font-size:9px;color:var(--card-fg-muted);margin-top:1px;\">Main table · 8 members</div>\n      </div>\n      <button style=\"margin-left:auto;background:var(--card-accent);color:#fff;border:0;border-radius:6px;padding:6px 8px;font:700 9px/1 inherit;\">+ Add</button>\n    </div>\n  </div>\n  <div style=\"min-height:0;padding: