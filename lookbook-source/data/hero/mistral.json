{"hero":"<div class=\"mistral-card\">\n  <style>\n    .mistral-card{font-family:Arial,'Pretendard','Apple SD Gothic Neo',sans-serif;background:var(--card-bg,#FFFAEB);color:var(--card-fg,#000);height:100%;min-height:300px;display:grid;grid-template-columns:44px 1fr;overflow:hidden}\n    .mc-rail{background:#000;color:#FFFAEB;padding:12px 9px;display:flex;flex-direction:column;align-items:center;gap:14px}\n    .mc-logo{width:26px;height:26px;display:block}\n    .mc-rail-dot{width:18px;height:18px;border:1px solid #4A463E;display:grid;place-items:center}\n    .mc-rail-dot:before{content:'';width:6px;height:6px;background:#FF8205}\n    .mc-rail-line{width:14px;height:2px;background:#625D52}\n    .mc-main{padding:12px;background:radial-gradient(circle at 1px 1px,color-mix(in srgb,var(--card-accent,#FA500F) 24%,transparent) 1px,transparent 0);background-size:12px 12px;display:flex;flex-direction:column;gap:10px}\n    .mc-top{display:flex;align-items:center;justify-content:space-between;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}\n    .mc-badge{border:1px solid var(--card-border,#E9E2CB);background:var(--card-surface,#FFF);padding:4px 6px}\n    .mc-title{font-size:22px;line-height:.94;letter-spacing:-.045em;font-weight:700;max-width:132px;margin-top:3px}\n    .mc-title span{color:var(--card-accent,#FA500F)}\n    .mc-board{margin-top:auto;background:var(--card-surface,#FFF);border:1px solid var(--card-border,#E9E2CB);box-shadow:5px 5px 0 var(--card-accent,#FA500F);padding:10px}\n    .mc-board-head{display:flex;justify-content:space-between;align-items:center;font-size:9px;color:var(--card-fg-muted,#625D52);margin-bottom:9px}\n    .mc-live{display:flex;align-items:center;gap:4px}.mc-live:before{content:'';width:5px;height:5px;background:#18A957}\n    .mc-flow{display:grid;grid-template-columns:1fr 14px 1fr;align-items:center;gap:5px}\n    .mc-node{border:1px solid var(--card-border,#E9E2CB);padding:7px 5px;font-size:8px;font-weight:700;min-height:38px}\n    .mc-node b{display:block;color:var(--card-accent,#FA500F);font-size:11px;margin-bottom:2px}\n    .mc-arrow{height:1px;background:var(--card-fg-muted,#625D52);position:relative}.mc-arrow:after{content:'';position:absolute;right:0;top:-2px;border-left:4px solid var(--card-fg-muted,#625D52);border-top:2px solid transparent;border-bottom:2px solid transparent}\n    .mc-footer{display:flex;gap:5px;margin-top:9px}.mc-chip{font-size:8px;border:1px solid var(--card-border,#E9E2CB);padding:4px 5px;background:var(--card-bg,#FFFAEB)}\n  </style>\n  <aside class=\"mc-rail\">\n    <svg class=\"mc-logo\" viewBox=\"0 0 28 28\" aria-label=\"Mistral pixel cat\" role=\"img\" shape-rendering=\"crispEdges\">\n      <path fill=\"#FFD800\" d=\"M2 2h6v4h12V2h6v8H2z\"/>\n      <path fill=\"#FFAF00\" d=\"M2 10h24v4H2z\"/>\n      <path fill=\"#FF8205\" d=\"M2 14h6v4h4v-4h4v4h4v-4h6v8H2z\"/>\n      <path fill=\"#FA500F\" d=\"M6 22h16v4H6z\"/>\n      <path fill=\"#000\" d=\"M8 14h4v4H8zm8 0h4v4h-4z\"/>\n    </svg>\n    <span class=\"mc-rail-dot\"></span><span class=\"mc-rail-line\"></span><span class=\"mc-rail-line\"></span><span class=\"mc-rail-line\"></span>\n  </aside>\n  <main class=\"mc-main\">\n    <div class=\"mc-top\"><span>Mistral Studio</span><span class=\"mc-badge\">V26</span></div>\n    <div class=\"mc-title\">Build your own <span>AI future.</span></div>\n    <section class=\"mc-board\">\n      <div class=\"mc-board-head\"><strong style=\"color:var(--card-fg,#000)\">Agent workflow</strong><span class=\"mc-live\">Running</span></div>\n      <div class=\"mc-flow\">\n        <div class=\"mc-node\"><b>01</b>Prompt</div><span class=\"mc-arrow\"></span><div class=\"mc-node\"><b>02</b>Deploy</div>\n      </div>\n      <div class=\"mc-footer\"><span class=\"mc-chip\">Vibe</span><span class=\"mc-chip\">Studio</span><span class=\"mc-chip\">Forge</span></div>\n    </section>\n  </main>\n</div>","card_tokens":{"light":{"bg":"#FFFAEB","surface":"#FFFFFF","border":"#E9E2CB","fg":"#000000","fg_muted":"#625D52","accent":"#FA500F"},"dark":{"bg":"#12110F","surface":"#1E1E1E","border":"#403B31","fg":"#FFFAEB","fg_muted":"#C9BEA1","accent":"#FF8205"}}}