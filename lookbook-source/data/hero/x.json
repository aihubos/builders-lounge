{"hero":"<div class=\"x-card\" style=\"height:100%;background:var(--card-bg);color:var(--card-fg);font-family:'TwitterChirp',-apple-system,BlinkMacSystemFont,'Segoe UI','Noto Sans KR',sans-serif;\">\n  <style>\n    .x-card,.x-card *{box-sizing:border-box}.x-card{display:grid;grid-template-rows:36px 35px 57px 1fr;overflow:hidden;letter-spacing:-.01em}.xc-top{display:grid;place-items:center;border-bottom:1px solid var(--card-border)}.xc-logo{width:18px;height:18px;fill:var(--card-fg)}.xc-tabs{position:relative;display:grid;grid-template-columns:1fr 1fr;align-items:center;border-bottom:1px solid var(--card-border);font-size:11px;color:var(--card-fg-muted);text-align:center}.xc-tabs b{align-self:stretch;display:grid;place-items:center;color:var(--card-fg);font-weight:700}.xc-tabs i{position:absolute;bottom:0;left:19%;width:12%;height:3px;border-radius:999px;background:#1D9BF0}.xc-compose{display:flex;align-items:center;gap:8px;padding:8px 10px;border-bottom:1px solid var(--card-border)}.xc-avatar{width:30px;height:30px;flex:none;border-radius:50%;background:linear-gradient(145deg,#6C5CE7,#1D9BF0 55%,#9BE7FF)}.xc-prompt{min-width:0;flex:1;color:var(--card-fg-muted);font-size:11px;white-space:nowrap;overflow:hidden}.xc-button{padding:7px 11px;border-radius:999px;background:var(--card-accent);color:var(--card-bg);font-size:10px;font-weight:800}.xc-post{display:flex;gap:8px;padding:9px 10px;overflow:hidden}.xc-post .xc-avatar{width:31px;height:31px;background:linear-gradient(145deg,#111 0 48%,#555 49% 55%,#F1F1F1 56%)}.xc-copy{min-width:0;flex:1;font-size:10px}.xc-name{display:flex;align-items:center;gap:3px;white-space:nowrap}.xc-name strong{font-size:11px}.xc-check{width:12px;height:12px;fill:#1D9BF0}.xc-handle{overflow:hidden;color:var(--card-fg-muted);text-overflow:ellipsis}.xc-text{margin:3px 0 7px;font-size:11px;line-height:1.35}.xc-media{height:52px;position:relative;display:flex;align-items:center;justify-content:space-between;overflow:hidden;padding:0 12px;border:1px solid var(--card-border);border-radius:10px;background:linear-gradient(120deg,#050505,#242424);color:#fff}.xc-media:after{content:\"\";position:absolute;right:-18px;width:70px;height:70px;border:1px solid #444;border-radius:50%}.xc-media span{position:relative;z-index:1;font-size:8px;line-height:1.25;letter-spacing:.08em;text-transform:uppercase}.xc-media svg{position:relative;z-index:1;width:24px;height:24px;fill:#fff}.xc-actions{display:flex;justify-content:space-between;margin-top:7px;color:var(--card-fg-muted)}.xc-action{display:flex;align-items:center;gap:3px}.xc-action svg{width:11px;height:11px;fill:none;stroke:currentColor;stroke-width:1.7}\n  </style>\n  <div class=\"xc-top\"><svg class=\"xc-logo\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18.244 2h3.308l-7.227 8.26L22.583 22h-6.657l-5.214-6.817L4.748 22H1.438l7.724-8.827L1 2h6.826l4.713 6.231L18.244 2Zm-1.161 18h1.83L6.831 3.895H4.868L17.083 20Z\"/></svg></div>\n  <div class=\"xc-tabs\"><b>추천</b><span>팔로우 중</span><i></i></div>\n  <div class=\"xc-compose\"><div class=\"xc-avatar\"></div><div class=\"xc-prompt\">무슨 일이 일어나고 있나요?</div><div class=\"xc-button\">게시</div></div>\n  <article class=\"xc-post\">\n    <div class=\"xc-avatar\"></div>\n    <div class=\"xc-copy\">\n      <div class=\"xc-name\"><strong>X Design</strong><svg class=\"xc-check\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M22.25 12c0-1.43-1.09-2.59-2.48-2.74.35-1.35-.38-2.76-1.68-3.25-1.31-.5-2.76.1-3.36 1.36A2.76 2.76 0 0 0 12 4.75c-1.43 0-2.59 1.09-2.74 2.48a2.76 2.76 0 0 0-3.25 1.68c-.5 1.31.1 2.76 1.36 3.36A2.76 2.76 0 0 0 4.75 15c0 1.43 1.09 2.59 2.48 2.74-.35 1.35.38 2.76 1.68 3.25 1.31.5 2.76-.1 3.36-1.36A2.76 2.76 0 0 0 15 22.25c1.43 0 2.59-1.09 2.74-2.48 1.35.35 2.76-.38 3.25-1.68.5-1.31-.1-2.76-1.36-3.36A2.76 2.76 0 0 0 22.25 12Zm-11.71 4.2-3.15-3.15 1.41-1.41 1.74 1.73 4.66-4.66 1.41 1.42-6.07 6.07Z\"/></svg><span class=\"xc-handle\">@design · 2분</span></div>\n      <p class=\"xc-text\">지금 이 순간의 대화를 한 화면에서.</p>\n      <div class=\"xc-media\"><span>WHAT'S<br>HAPPENING</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18.244 2h3.308l-7.227 8.26L22.583 22h-6.657l-5.214-6.817L4.748 22H1.438l7.724-8.827L1 2h6.826l4.713 6.231L18.244 2Zm-1.161 18h1.83L6.831 3.895H4.868L17.083 20Z\"/></svg></div>\n      <div class=\"xc-actions\">\n        <span class=\"xc-action\"><svg viewBox=\"0 0 24 24\"><path d=\"M20.5 11.5a8.5 8.5 0 1 1-3.3-6.7\"/><path d=\"m21 3-4 7 4-1\"/></svg>18</span>\n        <span class=\"xc-action\"><svg viewBox=\"0 0 24 24\"><path d=\"m7 7 3-3 3 3M10 4v11a4 4 0 0 0 4 4h3\"/><path d=\"m17 17 3 2-3 2\"/></svg>86</span>\n        <span class=\"xc-action\"><svg viewBox=\"0 0 24 24\"><path d=\"M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.7-7.5 1.1-1.1a5.5 5.5 0 0 0 0-7.8Z\"/></svg>1.4K</span>\n        <span class=\"xc-action\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 19V9m5 10V5m6 14v-7m5 7V3\"/></svg>42K</span>\n      </div>\n    </div>\n  </article>\n</div>","card_tokens":{"light":{"bg":"#FFFFFF","surface":"#F7F9F9","border":"#EFF3F4","fg":"#0F1419","fg_muted":"#536471","accent":"#000000"},"dark":{"bg":"#000000","surface":"#16181C","border":"#2F3336","fg":"#E7E9EA","fg_muted":"#71767B","accent":"#FFFFFF"}}}